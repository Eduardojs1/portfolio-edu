# Cabeçalhos da Cloudflare Pages (este arquivo vai junto para o dist/)

# Arquivos do build têm o hash no nome: podem ficar em cache "para sempre"
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens e o favicon: uma semana
/img/*
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800

# Segurança básica em todas as páginas
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
